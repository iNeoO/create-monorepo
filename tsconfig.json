{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": [
		"src/**/*",
		"test/**/*",
		"vitest.config.ts",
		"vitest.e2e.config.ts"
	]
}
